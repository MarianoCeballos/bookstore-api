{
  "name": "bookstore-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "yarn@4.15.0",
  "scripts": {
    "build": "nest build",
    "start": "node -r module-alias/register dist/main.js",
    "dev": "yarn migration:up && yarn openapi:write && yarn start --watch",
    "start:prod": "node -r module-alias/register dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\"",
    "lint:fix": "yarn lint --fix",
    "lint:all": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch --coverage=false",
    "test:cov": "jest --coverage",
    "migration:create": "yarn build && npx mikro-orm migration:create",
    "migration:up": "npx mikro-orm migration:up",
    "migration:down": "npx mikro-orm migration:down",
    "generate:seed": "npx mikro-orm seeder:run",
    "openapi:write": "yarn build && node -r module-alias/register dist/generate-openapi.js",
    "seed": "mikro-orm seeder:run --config ./dist/core/database/mikro-orm.config.js",
    "data:import": "yarn build && node -r module-alias/register dist/core/database/import-legacy.js",
    "sanitycheck": "yarn typecheck && yarn lint && yarn test --runInBand && yarn build",
    "prepare": "husky"
  },
  "dependencies": {
    "@mikro-orm/cli": "6.6.17",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@mikro-orm/reflection": "6.6.17",
    "@mikro-orm/seeder": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "helmet": "8.1.0",
    "joi": "18.0.1",
    "mercadopago": "3.6.1",
    "module-alias": "2.2.3",
    "nestjs-i18n": "10.6.1",
    "nodemailer": "7.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pdfkit": "0.20.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/nodemailer": "7.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "16.4.0",
    "prettier": "3.7.4",
    "supertest": "7.2.2",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "_moduleAliases": {
    "src": "dist"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --fix",
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/core/database/mikro-orm.config.ts",
      "./dist/core/database/mikro-orm.config.js"
    ]
  }
}